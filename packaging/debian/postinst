#!/bin/sh
set -e

ROOT=${RIGFORGE_PKG_ROOT:-}
STATE=$ROOT/var/lib/rigforge
CONFIG=$ROOT/etc/rigforge/config.json
RETRY='sudo rigforge upgrade'

case "$1" in
configure)
    old=$2
    new=$(dpkg-query -W -f '${Version}' rigforge 2>/dev/null || true)
    if [ -n "$old" ] && [ -n "$new" ] && [ -f "$CONFIG" ] && dpkg --compare-versions "$new" gt "$old"; then
        if mkdir -p "$STATE" && printf '%s\n' "$new" >"$STATE/upgrade-pending.tmp" && mv -f "$STATE/upgrade-pending.tmp" "$STATE/upgrade-pending"; then
            if [ -d "$ROOT/run/systemd/system" ] && systemctl daemon-reload && systemctl start --no-block rigforge-upgrade.service; then
                echo "rigforge: upgrade to $new queued outside dpkg; follow it with: journalctl -u rigforge-upgrade"
            else
                echo "rigforge: could not start the upgrade unit; run: $RETRY" >&2
            fi
        else
            echo "rigforge: could not queue the upgrade; run: $RETRY" >&2
        fi
    fi
    ;;
esac

exit 0
