#!/bin/sh
set -e

ROOT=${RIGFORGE_PKG_ROOT:-}
STATE=$ROOT/var/lib/rigforge
CONFIG=$ROOT/etc/rigforge/config.json
RETRY='sudo rigforge upgrade'

case "$1" in
configure)
    old=$2
    install -d -m 0755 "$STATE"
    if [ -d "$ROOT/run/systemd/system" ]; then systemctl daemon-reload || true; fi
    if [ -z "$old" ]; then
        echo "rigforge: installed; nothing on this host changed. Provision with: sudo rigforge setup"
    fi
    new=$(dpkg-query -W -f '${Version}' rigforge 2>/dev/null || true)
    if [ -n "$old" ] && [ -n "$new" ] && [ -f "$CONFIG" ] && dpkg --compare-versions "$new" gt "$old"; then
        if tmp=$(mktemp "$STATE/.upgrade-pending.XXXXXX") && chmod 0644 "$tmp" && printf '%s\n' "$new" >"$tmp" && mv -f "$tmp" "$STATE/upgrade-pending"; then
            if [ -d "$ROOT/run/systemd/system" ] && systemctl start --no-block rigforge-upgrade.service; then
                echo "rigforge: upgrade to $new queued outside dpkg; follow it with: journalctl -u rigforge-upgrade"
            else
                echo "rigforge: could not start the upgrade unit; run: $RETRY" >&2
            fi
        else
            echo "rigforge: could not queue the upgrade; run: $RETRY" >&2
        fi
    fi
    ;;
esac

exit 0
