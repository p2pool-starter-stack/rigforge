[Unit]
Description=RigForge sister API server (persistent, serves pre-computed state)
After=network.target

[Service]
ExecStart=/usr/bin/python3 ${CREDENTIALS_DIRECTORY}/server $API_BIND $API_PORT /run/rigforge-api ${CREDENTIALS_DIRECTORY}/config
LoadCredential=config:$SCRIPT_DIR/config.json
LoadCredential=server:$SCRIPT_DIR/util/api-server.py
Restart=always
RestartSec=5
DynamicUser=yes
Nice=19
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
