[Unit]
Description=RigForge control apply (persist + apply a staged config change, off the request path)

[Service]
Type=oneshot
# Root, because it writes config.json and restarts the miner — the privileged half the network
# receiver deliberately is not. Triggered by rigforge-control-apply.path when a change is staged;
# normal priority so an accepted config apply reaches a terminal result promptly. It re-validates the
# staged change, snapshots the old config to config-backups/, applies, and rolls back on a failed
# restart. Unlike background telemetry, an accepted operator request must not be starved behind the
# miner; RIGFORGE_OPERATOR (baked at setup) is who the new config + backups get handed back to.
Environment=RIGFORGE_OPERATOR=$RIGFORGE_OPERATOR
Environment=RIGFORGE_APPLIANCE=$RIGFORGE_APPLIANCE
RuntimeDirectory=rigforge-control
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=$SCRIPT_DIR/rigforge.sh control-apply
# #509: systemd's implicit DefaultTimeoutStartSec is 90s, and a full-path change (anything outside
# CONTROL_FAST_PATH_KEYS — DONATION, pools, autotune, watchdog) spends most of that before it can
# record anything: restart XMRig, then _apply_pool_check (~15s) and _wait_miner_live
# (CONTROL_LIVE_TRIES=20 x 3s = ~60s) while the RandomX dataset reallocates — and a failed attempt
# runs both again for the rollback. Being killed there loses the run silently (the trap in
# control_apply now records a `failed`, but a change that was merely SLOW is not a failure). The
# path's own retry counts are the real bound; this only stops systemd cutting in under them.
# tests/e2e-real.sh's control phase polls 300s for the same reason: "big-page hosts can take ~150s".
TimeoutStartSec=600
