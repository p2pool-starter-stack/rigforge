[Unit]
Description=RigForge control server (writable config endpoint, staged apply)
After=network.target

[Service]
ExecStart=/usr/bin/python3 ${CREDENTIALS_DIRECTORY}/server $CONTROL_BIND $CONTROL_PORT ${STATE_DIRECTORY} ${CREDENTIALS_DIRECTORY}/config
LoadCredential=config:$SCRIPT_DIR/config.json
LoadCredential=server:$SCRIPT_DIR/util/control-server.py
Environment=RIGFORGE_API_PORT=$API_PORT
Restart=always
RestartSec=5
DynamicUser=yes
StateDirectory=rigforge-control
Nice=19
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
