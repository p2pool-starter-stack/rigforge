# User-generated config (created from config.minimal.json)
config.json

# Runtime artifacts
/data/
/xmrig/
/xmrig-*/
/xmrig.log

# Backup archives (rigforge backup)
/backups/

# Config snapshots written by the control path before each applied change (#236)
/config-backups/

# Coverage output + cache (make coverage / CI coverage job)
/coverage/
/.coverage-cache/

# Local code knowledge graph
/graphify-out/

# OS
.DS_Store

# #254 config-change provenance marker (runtime state)
.rigforge-config-meta.json

# Python bytecode from util/*.py (the suite imports them; never a tracked artifact).
__pycache__/
*.pyc
