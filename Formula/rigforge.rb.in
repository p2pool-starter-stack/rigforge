class Rigforge < Formula
  desc "Provision and run a tuned XMRig worker for RandomX mining"
  homepage "https://github.com/p2pool-starter-stack/rigforge"
  url "@URL@"
  sha256 "@SHA256@"
  license "MIT"

  depends_on "bash"
  depends_on "flock"
  depends_on "jq"

  def install
    libexec.install Dir["*"]
    (libexec/".rigforge-package").write "brew\n"
    (bin/"rigforge").write_env_script libexec/"rigforge.sh",
      PATH:               "#{formula_opt_bin("bash")}:#{formula_opt_bin("jq")}:#{formula_opt_bin("flock")}:$PATH",
      RIGFORGE_LIB:       libexec.to_s,
      RIGFORGE_STATE:     "#{var}/rigforge".to_s
  end

  def caveats
    <<~EOS
      Installing does nothing to this machine. Configure and provision explicitly:
        mkdir -p #{var}/rigforge
        cp #{opt_libexec}/config.minimal.json #{var}/rigforge/config.json
        sudo "$(command -v rigforge)" setup
      config.json, backups and data live in #{var}/rigforge and survive a brew upgrade, which
      replaces only the code in #{opt_libexec}. A running miner is never
      restarted automatically; run `sudo "$(command -v rigforge)" apply` yourself after reviewing the release notes.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/rigforge --version")
  end
end
